{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "^/api/.*",
      "dest": "server.js"
    },
    {
      "src": "^/images/.*",
      "dest": "/images/$1"
    },
    {
      "src": "^/(.*\\.(?:css|js|json|webmanifest|png|jpg|jpeg|gif|webp|svg|ico|woff|woff2))$",
      "dest": "/$1"
    },
    {
      "src": "^/(?:team|register|request-invite)$",
      "dest": "server.js"
    },
    {
      "src": "^/.*",
      "dest": "server.js"
    }
  ]
}
